@model IReadOnlyCollection<MediCare.Core.PatientPrescription>
@{ ViewData["Title"] = "Prescription History"; }
<div class="container mt-4">
    <h1>Prescription history</h1>
    <p class="text-muted">Prescription information recorded for your account.</p>
    @if (!Model.Any()) { <p>No prescription records are available.</p> }
    else
    {
        <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Date</th><th>Medication</th><th>Prescribed by</th><th>Recorded instructions</th></tr></thead><tbody>
        @foreach (var item in Model) { <tr><td>@item.PrescribedAt.ToString("d")</td><td>@item.MedicationName</td><td>@item.PrescribedBy</td><td>@(string.IsNullOrWhiteSpace(item.Instructions) ? "—" : item.Instructions)</td></tr> }
        </tbody></table></div>
    }
    <a asp-controller="Home" asp-action="PatientDashboard">Back to dashboard</a>
</div>
