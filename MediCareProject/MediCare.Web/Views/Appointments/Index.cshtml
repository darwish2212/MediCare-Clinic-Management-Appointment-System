@model IReadOnlyList<MediCare.Core.Specialization>
@{
    ViewData["Title"] = "Book an appointment";
}

<h1>Book an appointment</h1>
<p>Choose a specialization to see its doctors.</p>
@if (Model.Count == 0)
{
    <p>No specializations are available yet.</p>
}
else
{
    <div class="list-group">
    @foreach (var specialization in Model)
    {
        <a class="list-group-item list-group-item-action" asp-action="Doctors" asp-route-specializationId="@specialization.Id">
            <strong>@specialization.Name</strong>
            @if (!string.IsNullOrWhiteSpace(specialization.Description)) { <span class="d-block">@specialization.Description</span> }
        </a>
    }
    </div>
}
